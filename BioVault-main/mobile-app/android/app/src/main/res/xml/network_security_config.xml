<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for Bio-Vault Protocol
  
  In debug builds, allows:
  1. Cleartext (HTTP) to localhost/127.0.0.1 (for adb reverse dev setup)
  2. User-installed CA certificates (for self-signed HTTPS certs in dev)
  
  In release builds, only HTTPS with system CAs is allowed.
-->
<network-security-config>
    <!-- Allow cleartext to localhost for development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Debug overrides: trust user-installed CAs (self-signed certs) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
