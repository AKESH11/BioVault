# Blockchain Configuration
POLYGON_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_API_KEY
PRIVATE_KEY=your_wallet_private_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# IPFS Configuration
IPFS_PROJECT_ID=your_infura_ipfs_project_id
IPFS_PROJECT_SECRET=your_infura_ipfs_secret

# Backend Configuration
PORT=3000
NODE_ENV=development

# Mobile App Configuration
ENABLE_ZKP=true
ENABLE_PRNU=true
BLE_DISCOVERY_TIMEOUT=30000

# Smart Contract Addresses (will be populated after deployment)
MEDIA_ANCHOR_CONTRACT=
AUTHENTICITY_TOKEN_CONTRACT=
