{
  "name": "bio-vault-protocol",
  "version": "1.0.0",
  "description": "Decentralized Proof of Reality Infrastructure - Physiological Media Anchoring & Multi-Party Consent",
  "private": true,
  "workspaces": [
    "mobile-app",
    "smart-contracts",
    "zkp-circuits",
    "backend",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:mobile && npm run install:contracts && npm run install:backend",
    "install:mobile": "cd mobile-app && npm install",
    "install:contracts": "cd smart-contracts && npm install",
    "install:backend": "cd backend && npm install",
    "install:zkp": "cd zkp-circuits && npm install",
    "build:cpp": "cd mobile-app/cpp && cmake -B build && cmake --build build",
    "build:contracts": "cd smart-contracts && npx hardhat compile",
    "build:zkp": "cd zkp-circuits && circom circuits/verify.circom --r1cs --wasm --sym",
    "dev:backend": "cd backend && npm run dev",
    "test:contracts": "cd smart-contracts && npx hardhat test",
    "deploy:testnet": "cd smart-contracts && npx hardhat run scripts/deploy.js --network mumbai",
    "mobile:android": "cd mobile-app && npm run android",
    "mobile:ios": "cd mobile-app && npm run ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "clean": "rm -rf node_modules */node_modules */build */dist"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "biometrics",
    "blockchain",
    "deepfake-detection",
    "rppg",
    "zero-knowledge",
    "decentralized",
    "proof-of-reality"
  ],
  "author": "Bio-Vault Protocol Team",
  "license": "MIT"
}
