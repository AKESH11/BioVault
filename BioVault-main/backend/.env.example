# ============================================================================
# Bio-Vault Backend Configuration
# Copy this file to .env and fill in the values
#
# For local Hardhat dev, copy .env.local instead
# For Polygon Amoy testnet, copy .env.amoy instead
# ============================================================================

# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ============================================================================
# Blockchain
# ============================================================================
# Local Hardhat: http://127.0.0.1:8545
# Polygon Amoy:  https://rpc-amoy.polygon.technology
# Polygon Main:  https://polygon-rpc.com
POLYGON_RPC_URL=http://127.0.0.1:8545

# Server-side wallet private key (NEVER commit real keys to git!)
# Local dev: use Hardhat account #0 (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
# Testnet:   export from MetaMask, fund via https://faucet.polygon.technology/
# The WalletManager (src/utils/wallet.js) handles nonce management, gas
# estimation, and retry logic for all blockchain writes.
DEPLOYER_PRIVATE_KEY=

# Contract addresses (from smart-contracts/deployments.json)
# Deploy: cd smart-contracts && npx hardhat run scripts/deploy.js --network localhost
MEDIA_ANCHOR_CONTRACT=
AUTHENTICITY_TOKEN_CONTRACT=
VERIFIER_CONTRACT=

# ============================================================================
# IPFS (Self-hosted Kubo node)
# ============================================================================
# Install Kubo: https://docs.ipfs.tech/install/
# Run: ipfs init && ipfs daemon
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=https://ipfs.io

# ============================================================================
# Pinata IPFS (optional — redundant cloud pinning)
# ============================================================================
# Get JWT at: https://app.pinata.cloud/developers/api-keys
# PINATA_JWT=
# PINATA_GATEWAY=your-gateway.mypinata.cloud

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_FILE=logs/biovault.log

# ============================================================================
# Error Tracking (optional)
# ============================================================================
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
