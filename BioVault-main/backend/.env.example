# ============================================================================
# Bio-Vault Backend Configuration
# Copy this file to .env and fill in the values
# ============================================================================

# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ============================================================================
# Blockchain (Polygon Amoy Testnet)
# ============================================================================
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# Server-side wallet private key (NEVER commit this to git!)
# Export from MetaMask: Account Details > Show Private Key
# Fund with POL from: https://faucet.polygon.technology/
DEPLOYER_PRIVATE_KEY=

# Contract addresses (from deployments.json after running deploy script)
MEDIA_ANCHOR_CONTRACT=0x7bCD78E5c8317C914Da948A24a13cE6138F77bDe
AUTHENTICITY_TOKEN_CONTRACT=
VERIFIER_CONTRACT=

# ============================================================================
# IPFS (Self-hosted Kubo node)
# ============================================================================
# Install Kubo: https://docs.ipfs.tech/install/
# Run: ipfs init && ipfs daemon
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_FILE=logs/biovault.log
